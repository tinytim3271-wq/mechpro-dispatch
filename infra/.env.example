# MechPro CDK / Lambda environment (reference only — CDK sets most values at deploy time).
# Copy to .env for local Lambda debugging or ad-hoc scripts; do not commit secrets.

# AWS
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# DynamoDB (Lambda aliases: SHOP_TABLE, TABLE_NAME)
TABLE_NAME=mechpro-data

# Cognito (Lambda aliases: COGNITO_USER_POOL_ID, USER_POOL_ID)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 files bucket (Lambda aliases: S3_BUCKET, FILES_BUCKET_NAME)
FILES_BUCKET_NAME=

# Frontend URL for redirects / CORS tightening
APP_URL=https://www.yourcarguy806.com

# Bedrock AI
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Per-shop secrets — create in AWS Secrets Manager, not in this file:
#   mechpro/{shopId}/stripe-secret-key
#   mechpro/{shopId}/stripe-webhook-secret
#   mechpro/{shopId}/agentphone-api-key
#   mechpro/{shopId}/agentphone-webhook-secret
