{
  "name": "mechpro-dispatch",
  "version": "1.0.0",
  "description": "MechPro Dispatch & Work Orders web, Android, and Windows desktop clients",
  "private": true,
  "main": "desktop/main.js",
  "author": "MechPro",
  "license": "UNLICENSED",
  "scripts": {
    "copy-web": "cp index.html styles.css theme.css app.js diagnostics-ui.js service-worker.js manifest.webmanifest mechpro-icon.svg www/ && cp -r assets www/",
    "sync": "npm run copy-web && npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "npm run sync",
    "desktop": "electron .",
    "build:j2534": "bash diagnostics/j2534-service/scripts/publish-win-x64.sh",
    "build:windows": "npm run build:j2534 && electron-builder --win nsis --publish never",
    "build:windows:zip": "npm run build:j2534 && electron-builder --win zip --publish never",
    "test:j2534": "node diagnostics/j2534-host-node/test/host.test.js"
  },
  "build": {
    "appId": "com.mechpro.dispatch",
    "productName": "MechPro",
    "artifactName": "MechPro-Setup-${version}.${ext}",
    "publish": null,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "app.js",
      "diagnostics-ui.js",
      "index.html",
      "styles.css",
      "theme.css",
      "manifest.webmanifest",
      "service-worker.js",
      "mechpro-icon.svg",
      "assets/**/*",
      "desktop/**/*",
      "diagnostics/j2534-host-node/**/*",
      "diagnostics/coverage/**/*",
      "downloads/**"
    ],
    "extraResources": [
      {
        "from": "diagnostics/j2534-host-node",
        "to": "j2534-host-node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "diagnostics/j2534-service/publish/win-x64",
        "to": "j2534-host",
        "filter": [
          "J2534.Host.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MechPro"
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
