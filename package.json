{
  "name": "mechpro-desktop",
  "version": "1.0.0",
  "description": "MechPro Dispatch & Work Orders Windows desktop client",
  "main": "desktop/main.js",
  "author": "MechPro",
  "license": "UNLICENSED",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --watch",
    "serve": "python3 -m http.server 3000 --bind 127.0.0.1",
    "validate:infra": "bash -lc 'cd infra && npm test -- --runInBand && npm run build'",
    "validate": "npm run build:web && npm run validate:infra",
    "compare-folder": "node scripts/compare-folders.mjs",
    "desktop": "electron .",
    "build:windows": "npm run build:web && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.mechpro.dispatch",
    "productName": "MechPro",
    "artifactName": "MechPro-Setup-${version}.${ext}",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "app.js",
      "index.html",
      "styles.css",
      "theme.css",
      "manifest.webmanifest",
      "service-worker.js",
      "mechpro-icon.svg",
      "assets/**/*",
      "desktop/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MechPro"
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0"
  }
}
